<!DOCTYPE html>
<html>
<head>
  <title>Login</title>
  <link  rel="stylesheet"  href="/css/login-style.css"  />
  <link  rel="stylesheet"  href="/css/adminstyle.css"  />
</head>
<body>
  <div class="card">
    <h2>Login</h2>
    <form method="post" action="/login">
