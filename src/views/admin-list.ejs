<!-- views/admin-list.ejs -->

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title>Admin Management</title>

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    body{
      font-family:Arial, Helvetica, sans-serif;
      background:#0f172a;
      color:white;
    }

    .layout{
      display:flex;
      min-height:100vh;
    }

    /* ================= SIDEBAR ================= */

    .sidebar{
      width:260px;
      background:#111827;
      padding:25px;
      border-right:1px solid rgba(255,255,255,0.1);
    }

    .logo{
      font-size:28px;
      font-weight:bold;
      margin-bottom:40px;
      color:#38bdf8;
      text-align:center;
    }

    .menu{
      display:flex;
      flex-direction:column;
      gap:15px;
    }

    .menu a{
      text-decoration:none;
      color:white;
      background:#1e293b;
      padding:14px 16px;
      border-radius:12px;
      transition:0.3s;
      font-size:15px;
      font-weight:bold;
    }

    .menu a:hover{
      background:#2563eb;
      transform:translateX(5px);
    }

    .logout{
      background:#dc2626 !important;
      margin-top:20px;
    }

    .logout:hover{
      background:#b91c1c !important;
    }

    /* ================= CONTENT ================= */

    .content{
      flex:1;
      padding:40px;
    }

    .topbar{
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin-bottom:30px;
    }

    .topbar h1{
      font-size:32px;
    }

    .user-box{
      background:#1e293b;
      padding:12px 18px;
      border-radius:12px;
      font-size:14px;
    }

    .card{
      background:#1e293b;
      padding:25px;
      border-radius:20px;
      box-shadow:0 5px 20px rgba(0,0,0,0.3);
    }

    .card-header{
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin-bottom:25px;
    }

    .card-header h2{
      font-size:24px;
    }

    .btn{
      text-decoration:none;
      background:#2563eb;
      color:white;
      padding:12px 18px;
      border-radius:10px;
      font-weight:bold;
      transition:0.3s;
    }

    .btn:hover{
      background:#1d4ed8;
    }

    table{
      width:100%;
      border-collapse:collapse;
      overflow:hidden;
      border-radius:15px;
    }

    table thead{
      background:#334155;
    }

    table th{
      padding:16px;
      text-align:left;
      font-size:15px;
    }

    table td{
      padding:16px;
      border-bottom:1px solid rgba(255,255,255,0.08);
      font-size:14px;
    }

    table tbody tr:hover{
      background:#273449;
    }

    .badge{
      background:#0ea5e9;
      padding:6px 12px;
      border-radius:20px;
      font-size:12px;
      font-weight:bold;
    }

    .action-btn{
      text-decoration:none;
      padding:8px 14px;
      border-radius:8px;
      font-size:13px;
      color:white;
      margin-right:8px;
      display:inline-block;
    }

    .edit{
      background:#16a34a;
    }

    .delete{
      background:#dc2626;
    }

    @media(max-width:900px){

      .layout{
        flex-direction:column;
      }

      .sidebar{
        width:100%;
      }

      .content{
        padding:20px;
      }

      table{
        display:block;
        overflow-x:auto;
      }

    }

  </style>
</head>

<body>

<div class="layout">

  <!-- ================= SIDEBAR ================= -->

  <div class="sidebar">

    <div class="logo">
      Admin Panel
    </div>

    <div class="menu">

      <a href="/dashboard">
        Dashboard
      </a>

      <a href="/products">
        Product Management
      </a>

      <a href="/admins">
        Admin Management
      </a>

      <a href="/users">
        User Management
      </a>

      <a href="/logout" class="logout">
        Logout
      </a>

    </div>

  </div>

  <!-- ================= CONTENT ================= -->

  <div class="content">

    <div class="topbar">

      <h1>Admin Management</h1>

      <div class="user-box">
        Welcome :
        <strong><%= user.username %></strong>
      </div>

    </div>

    <div class="card">

      <div class="card-header">

        <h2>Admin List</h2>

        <a href="/admins/add" class="btn">
          + Add Admin
        </a>

      </div>

      <table>

        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Tenant</th>
            <th>Action</th>
          </tr>
        </thead>

        <tbody>


          <% admins.forEach(admin => { %>

            <tr>

              <td>
                <%= admin.id.toString().slice(-3) %>
              </td>

              <td>
                <%= admin.name %>
              </td>
              <td>
                <%= admin.username %>
              </td>

              

              <td>
                <span class="badge">
                  <%= admin.role %>
                </span>
              </td>

              <td>
                <%= admin.tenantId %>
              </td>

              <td>

                <a
                  href="/admins/edit/<%= admin.id %>"
                  class="action-btn edit"
                >
                  Edit
                </a>

                <a
                  href="/admins/delete/<%= admin.id %>"
                  class="action-btn delete"
                >
                  Delete
                </a>

              </td>

            </tr>

          <% }) %>

        </tbody>

      </table>

    </div>

  </div>

</div>

</body>
</html>