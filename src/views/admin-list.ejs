<!-- views/admin-list.ejs -->

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title>Admin Management</title>

  <link  rel="stylesheet"  href="/adminstyle.css"  />
</head>

<body>

<div class="layout">

  <%- include('sidebar') %>


  <!-- ================= CONTENT ================= -->

  <div class="content">

    <div class="topbar">

      <h1>Admin Management</h1>

      <div class="user-box">
        Welcome :
        <strong><%= user.username %></strong>
      </div>

    </div>

    <div class="card">

      <div class="card-header">

        <h2>Admin List</h2>

        <a href="/admins/add" class="btn">
          + Add Admin
        </a>

      </div>

      <table>

        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Tenant</th>
            <th>Action</th>
          </tr>
        </thead>

        <tbody>


          <% admins.forEach(admin => { %>

            <tr>

              <td>
                <%= admin.id.toString().slice(-3) %>
              </td>

              <td>
                <%= admin.name %>
              </td>
              <td>
                <%= admin.username %>
              </td>

              

              <td>
                <span class="badge">
                  <%= admin.role %>
                </span>
              </td>

              <td>
                <%= admin.tenantId %>
              </td>

              <td>

                <a
                  href="/admins/edit/<%= admin.id %>"
                  class="action-btn edit"
                >
                  Edit
                </a>

                <a
                  href="/admins/delete/<%= admin.id %>"
                  class="action-btn delete"
                >
                  Delete
                </a>

              </td>

            </tr>

          <% }) %>

        </tbody>

      </table>

    </div>

  </div>

</div>

</body>
</html>