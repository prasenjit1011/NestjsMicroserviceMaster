<!-- views/dashboard.ejs -->

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title>Dashboard</title>

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    body{
      font-family:Arial, Helvetica, sans-serif;
      background:linear-gradient(135deg,#0f172a,#1e293b);
      min-height:100vh;
      display:flex;
      justify-content:center;
      align-items:center;
      padding:30px;
      color:white;
    }

    .card{
      width:100%;
      max-width:600px;
      background:rgba(255,255,255,0.08);
      backdrop-filter:blur(10px);
      border:1px solid rgba(255,255,255,0.1);
      border-radius:20px;
      padding:40px;
      box-shadow:0 10px 30px rgba(0,0,0,0.4);
    }

    .top{
      text-align:center;
      margin-bottom:30px;
    }

    .top h1{
      font-size:36px;
      margin-bottom:10px;
      color:#ffffff;
    }

    .top p{
      color:#cbd5e1;
      font-size:16px;
    }

    .info{
      background:rgba(255,255,255,0.06);
      padding:20px;
      border-radius:15px;
      margin-bottom:25px;
    }

    .info h3{
      margin-bottom:15px;
      font-size:18px;
      color:#f1f5f9;
    }

    .info span{
      color:#38bdf8;
      font-weight:bold;
    }

    .menu{
      display:flex;
      flex-direction:column;
      gap:15px;
    }

    .menu a{
      text-decoration:none;
      background:#2563eb;
      color:white;
      padding:14px;
      border-radius:12px;
      text-align:center;
      font-size:16px;
      font-weight:bold;
      transition:0.3s;
    }

    .menu a:hover{
      background:#1d4ed8;
      transform:translateY(-2px);
    }

    .logout{
      background:#dc2626 !important;
    }

    .logout:hover{
      background:#b91c1c !important;
    }

    .badge{
      display:inline-block;
      padding:6px 14px;
      border-radius:30px;
      font-size:14px;
      margin-top:10px;
      background:#0ea5e9;
      color:white;
      font-weight:bold;
    }

    @media(max-width:600px){

      .card{
        padding:25px;
      }

      .top h1{
        font-size:28px;
      }

    }

  </style>
</head>

<body>

  <div class="card">

    <div class="top">
      <h1>Dashboard</h1>

      <p>Login Successful</p>

      <div class="badge">
        <%= user.role %>
      </div>
    </div>

    <div class="info">

      <h3>
        Username :
        <span><%= user.username %></span>
      </h3>

      <h3>
        Role :
        <span><%= user.role %></span>
      </h3>

    </div>

    <div class="menu">

      <a href="/products">
        Product Management
      </a>

      <% if(user.role === 'superadmin'){ %>

        <a href="/admins">
          Admin Management
        </a>

      <% } %>

      <% if(user.role === 'admin'){ %>

        <a href="/users">
          User Management
        </a>

      <% } %>

      <a href="/logout" class="logout">
        Logout
      </a>

    </div>

  </div>

</body>
</html>