<!-- views/dashboard.ejs -->

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title>Dashboard</title>
  
  <style>
    

  </style>
  <link  rel="stylesheet"  href="/css/dashboard-style.css"  />
</head>

<body>

  <div class="card">

    <div class="top">
      <h1>Dashboard</h1>

      <p>Login Successful</p>

      <div class="badge">
        <%= user.role %>
      </div>
    </div>

    <div class="info">

      <h3>
        Username :
        <span><%= user.username %></span>
      </h3>

      <h3>
        Role :
        <span><%= user.role %></span>
      </h3>

    </div>

    <div class="menu">

      <a href="/products">
        Product Management
      </a>

      <% if(user.role === 'superadmin'){ %>

        <a href="/admins">
          Admin Management
        </a>

      <% } %>

      <% if(user.role === 'admin'){ %>

        <a href="/admins">
          User Management
        </a>

      <% } %>

      <a href="/logout" class="logout">
        Logout
      </a>

    </div>

  </div>

</body>
</html>