<!-- views/admin-add.ejs -->

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title>Add Admin</title>

  <link  rel="stylesheet"  href="/style.css"  />
  <link  rel="stylesheet"  href="/adminstyle.css"  />
  
</head>

<body>

<div class="layout">

    <%- include('sidebar') %>


  <!-- ================= CONTENT ================= -->

  <div class="content">




  <div class="card">

    <div class="title">
      <h1>Add Admin</h1>

      <p>Create new admin account</p>
    </div>

    <form method="post" action="/admins/add">

      <div class="form-group">

        <label>
          Name
        </label>

        <input
          type="text"
          name="name"
          placeholder="Enter name"
          required
        />

      </div>
      <div class="form-group">

        <label>
          Username
        </label>

        <input
          type="text"
          name="username"
          placeholder="Enter username"
          required
        />

      </div>

      <div class="form-group">

        <label>
          Password
        </label>

        <input
          type="password"
          name="password"
          placeholder="Enter password"
          required
        />

      </div>

      <div class="form-group">

        <label>
          Select Tenant
        </label>

        <select name="tenantId" required>

          <% tenants.forEach(x => { %>

            <option value="<%= x.tenantId %>">
              <%= x.name %>
            </option>

          <% }) %>

        </select>

      </div>

      <button type="submit" class="btn">
        Save Admin
      </button>

    </form>

    <div class="footer">

      <a href="/admins">
        ← Back to Admin List
      </a>

    </div>

  </div>

</div>
</div>
</body>
</html>