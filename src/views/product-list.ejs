<!-- views/admin-list.ejs -->

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title>Products</title>

    <link  rel="stylesheet"  href="/css/adminstyle.css"  />

</head>

<body>

<div class="layout">

  <%- include('sidebar') %>


  <!-- ================= CONTENT ================= -->

  <div class="content">

    <div class="topbar">

      <h1>Product Management</h1>

      <div class="user-box">
        Welcome :
        <strong>Add Product</strong>
      </div>

    </div>

    <div class="card">

      <div class="card-header">

        <h2>Product List</h2>

        <a href="/products/add" class="btn">
          + Add Product
        </a>




      </div>

      <table>

        <thead>


<tr>
  <th>Image</th>
  <th>Name</th>
  <th>Price</th>
  <th>Tenant</th>
  <th>Action</th>
</tr>
</thead>
<tbody>

<% products.forEach(x => { %>

<tr>

<td>
  <% if (x.image) { %>
    <img src="<%= x.image %>" alt="<%= x.name %>" width="80" />
  <% } else { %>
    &mdash;
  <% } %>
</td>

<td><%= x.name %></td>

<td><%= x.price %></td>

<td><%= x.tenantId %></td>

<td>

<a href="/products/edit/<%= x.id %>">
  Edit
</a>

<a href="/products/delete/<%= x.id %>">
  Delete
</a>

</td>

</tr>

<% }) %>

        </tbody>

      </table>




      
    </div>

  </div>

</div>

</body>
</html>



