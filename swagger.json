    "/api/items": {
      "post": {
        "operationId": "ItemController_create",
        "summary": "Create Item",
        "description": "Creates a new item.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateItemDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Item created successfully."
          },
          "400": {
            "description": "Validation failed."
          }
        },
        "tags": [
          "Item CRUD"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "get": {
        "operationId": "ItemController_findAll",
        "summary": "Get All Items",
        "description": "Returns paginated list of items.",
        "parameters": [
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Search by item name",
            "schema": {
              "example": "Samsung"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Records per page",
            "schema": {
              "example": 10
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Page number",
            "schema": {
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Items retrieved successfully."
          }
        },
        "tags": [
          "Item CRUD"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
