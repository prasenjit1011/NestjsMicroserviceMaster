  "info": {
    "title": "NestJS Microservice API",
    "description": "REST API Gateway for gRPC Item Service",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Auth",
      "description": ""
    },
    {
      "name": "Item CRUD",
