generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("NEON_POSTGRE_DATABASE_URL")
}

model Item {
  id        Int      @id @default(autoincrement())
  title     String
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("items")
}
