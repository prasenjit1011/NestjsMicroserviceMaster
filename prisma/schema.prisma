generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("NEON_POSTGRE_DATABASE_URL")
}

enum StockType {
  IN
  OUT
}

enum Role {
  INTERN
  ENGINEER
  ADMIN
}

model Item {
  id          Int         @id @default(autoincrement())
  name        String
  sku         String      @unique
  price       Decimal     @db.Decimal(10, 2)
  description String?

  stocks      ItemStock[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ItemStock {
  id        Int       @id @default(autoincrement())

  itemId    Int
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  qty       Int
  type      StockType

  createdAt DateTime  @default(now())
}

model Brand {
  id        Int       @id @default(autoincrement())
  title     String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Employee {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  role      Role

  password  String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model User {
  id        BigInt    @id @default(autoincrement())
  name      String    @db.VarChar(255)
  email     String    @unique @db.VarChar(255)
  password  String?   @db.VarChar(255)

  products  Product[]
}

model Product {
  id        BigInt          @id @default(autoincrement())
  name      String          @db.VarChar(255)
  price     Float?

  userId    BigInt?
  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  images    ProductImage[]

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model ProductImage {
  id         BigInt   @id @default(autoincrement())
  fileName   String?  @db.VarChar(255)
  imageUrl   String?  @db.VarChar(255)

  productId  BigInt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Food {
  id    BigInt  @id @default(autoincrement())
  name  String  @db.VarChar(255)
  price Float?
}

model Mobile {
  id    Int     @id @default(autoincrement())
  title String  @db.VarChar(255)
  price Int
}

model Player {
  id        Int      @id @default(autoincrement())
  username  String
  password  String

  createdAt DateTime @default(now())
}

model Trade {
  id        Int      @id @default(autoincrement())
  type      String
  userId    Int
  symbol    String
  shares    Int
  price     Int

  createdAt DateTime @default(now())
}